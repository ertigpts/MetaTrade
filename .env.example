# Local web server
HOST=127.0.0.1
PORT=5001
APP_ENV=development
FLASK_ENV=development
TAHLIL_DEBUG=0

# Generate a unique random value before first use.
TAHLIL_SECRET_KEY=replace-with-a-long-random-secret
TAHLIL_DATABASE_PATH=data/tradeai.sqlite3
TAHLIL_RUNTIME_DIR=runtime
TAHLIL_GUEST_FREE_ANALYSES=2
TAHLIL_TRUST_PROXY=0

# Application login (do not reuse your MetaTrader password)
TAHLIL_APP_USERNAME=admin
TAHLIL_APP_PASSWORD=replace-with-a-strong-password
TAHLIL_APP_USERNAME_2=
TAHLIL_APP_PASSWORD_2=
TAHLIL_APP_USERNAME_3=
TAHLIL_APP_PASSWORD_3=
TAHLIL_APP_USERNAME_4=
TAHLIL_APP_PASSWORD_4=

# MetaTrader 5 local terminal. Login fields are optional when MT5 is already signed in.
TAHLIL_MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
TAHLIL_MT5_TIMEOUT_MS=15000
TAHLIL_MT5_LOGIN=
TAHLIL_MT5_PASSWORD=
TAHLIL_MT5_SERVER=

# Safe default: signal generation only. Enable demo orders deliberately after testing.
TAHLIL_TRADING_MODE=signal_only
TAHLIL_MT5_ALLOW_DEMO_ORDERS=0
TAHLIL_MT5_MAX_TICK_AGE_SECONDS=300
TAHLIL_MT5_MAX_ENTRY_DRIFT_BPS=2.0

# AI provider (OpenAI-compatible endpoint)
TAHLIL_AI_API_KEY=
TAHLIL_AI_BASE_URL=https://api.openai.com/v1
TAHLIL_AI_ENDPOINT=
TAHLIL_AI_MODEL=gpt-4o-mini

# Market data and economic calendar
TWELVEDATA_API_KEY=
BUSINESSQUANT_API_KEY=
